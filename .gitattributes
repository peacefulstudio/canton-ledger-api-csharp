# Working-tree text must stay LF on every platform (Windows runners default
# to core.autocrlf=true and would check out CRLF).
* text=auto eol=lf
*.dar binary
*.binpb binary
*.png binary
*.cmd text eol=crlf
*.bat text eol=crlf

# Participant-served OpenAPI captures: verbatim evidence, never hand-edited.
docs/internal/research/served-schemas/*.yaml linguist-generated
