module RichTypes where

import DA.Time ()
import DA.TextMap (TextMap)

data Profile = Profile
  with
    nickname : Text
    level : Int
  deriving (Eq, Show)

data Outcome = Win with prize : Numeric 2; tier : Text
             | Pending
  deriving (Eq, Show)

template Marker
  with
    owner : Party
  where
    signatory owner

data HoldingView = HoldingView
  with
    amount : Decimal
  deriving (Eq, Show)

interface Holding where
  viewtype HoldingView

template Asset
  with
    issuer : Party
    amount : Decimal
  where
    signatory issuer
    interface instance Holding for Asset where
      view = HoldingView with amount

template RichRecord
  with
    owner : Party
    count : Int
    amount : Numeric 10
    label : Text
    active : Bool
    asOf : Date
    observedAt : Time
    note : Optional Text
    tags : [Text]
    attributes : TextMap Text
    marker : ContractId Marker
    holdingCid : ContractId Holding
    holdingCids : [ContractId Holding]
    profile : Profile
    outcome : Outcome
    fee : Numeric 2
  where
    signatory owner
    nonconsuming choice Relabel : ContractId RichRecord
      with
        newLabel : Text
      controller owner
      do
        create this with label = newLabel
