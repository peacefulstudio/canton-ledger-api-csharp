<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- snake_case test method names -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Daml.Runtime" />
    <PackageReference Include="Daml.Ledger.Abstractions" />
    <PackageReference Include="Peaceful.Canton.Localnet.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Canton.Ledger.Rest.Client\Canton.Ledger.Rest.Client.csproj" />
    <ProjectReference Include="..\Canton.Ledger.Testing.Localnet\Canton.Ledger.Testing.Localnet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared with Canton.Ledger.Grpc.Client.Integration.Tests: the Marker and Asset templates'
         DAR and generated bindings, so both transports' conformance tests exercise the same
         create/exercise/reassignment round trips against the same on-ledger templates. -->
    <Compile Include="..\Canton.Ledger.Grpc.Client.Integration.Tests\Generated\Richtypes\Marker.cs"
             Link="Generated\Richtypes\Marker.cs" />
    <Compile Include="..\Canton.Ledger.Grpc.Client.Integration.Tests\Generated\Richtypes\HoldingView.cs"
             Link="Generated\Richtypes\HoldingView.cs" />
    <Compile Include="..\Canton.Ledger.Grpc.Client.Integration.Tests\Generated\Richtypes\IHolding.cs"
             Link="Generated\Richtypes\IHolding.cs" />
    <Compile Include="..\Canton.Ledger.Grpc.Client.Integration.Tests\Generated\Richtypes\Asset.cs"
             Link="Generated\Richtypes\Asset.cs" />
    <None Include="..\Canton.Ledger.Grpc.Client.Integration.Tests\testdata\richtypes\richtypes.dar"
          Link="testdata\richtypes\richtypes.dar" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
