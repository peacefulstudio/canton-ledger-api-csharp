<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- snake_case test method names -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Daml.Ledger.Abstractions" />
    <PackageReference Include="Daml.Runtime" />
    <PackageReference Include="Peaceful.Canton.Localnet.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Canton.Ledger.Testing\Canton.Ledger.Testing.csproj" />
    <ProjectReference Include="..\..\src\Canton.Ledger.Rest.Client\Canton.Ledger.Rest.Client.csproj" />
    <ProjectReference Include="..\..\src\Canton.Ledger.Grpc.Client\Canton.Ledger.Grpc.Client.csproj" />
    <ProjectReference Include="..\..\src\Canton.Ledger.Pqs.Client\Canton.Ledger.Pqs.Client.csproj" />
    <ProjectReference Include="..\Canton.Ledger.Testing.Localnet\Canton.Ledger.Testing.Localnet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared with the gRPC/REST integration test projects: the generated bindings and DAR for
         the Marker template, and for the Asset template with the Holding interface it implements,
         so the parity bodies exercise the exact same template-family and interface-family round
         trips across the Fake, REST, and gRPC providers. -->
    <Compile Include="..\Canton.Ledger.Grpc.Client.Integration.Tests\Generated\RichTypes\Marker.cs"
             Link="Generated\RichTypes\Marker.cs" />
    <Compile Include="..\Canton.Ledger.Grpc.Client.Integration.Tests\Generated\RichTypes\Asset.cs"
             Link="Generated\RichTypes\Asset.cs" />
    <Compile Include="..\Canton.Ledger.Grpc.Client.Integration.Tests\Generated\RichTypes\IHolding.cs"
             Link="Generated\RichTypes\IHolding.cs" />
    <Compile Include="..\Canton.Ledger.Grpc.Client.Integration.Tests\Generated\RichTypes\HoldingView.cs"
             Link="Generated\RichTypes\HoldingView.cs" />
    <None Include="..\Canton.Ledger.Grpc.Client.Integration.Tests\testdata\richtypes\richtypes.dar"
          Link="testdata\richtypes\richtypes.dar" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Canton.Ledger.Rest.Client.Integration.Tests\LedgerApiVersionSkewGuard.cs"
             Link="Shared\LedgerApiVersionSkewGuard.cs" />
    <Compile Include="..\Canton.Ledger.Rest.Client.Integration.Tests\LedgerApiVersionSkewGuard.Live.cs"
             Link="Shared\LedgerApiVersionSkewGuard.Live.cs" />
  </ItemGroup>

</Project>
