<Project>
  <!--
    MSBuild targets for downloading Canton Ledger API proto files from Maven Central.

    Downloads:
    - com.daml:ledger-api-proto (Canton Ledger API protos)
    - com.daml:ledger-api-value-proto (Canton value types proto)
    - com.google.api.grpc:proto-google-common-protos (Google common protos)
  -->

  <PropertyGroup>
    <!-- Proto output directory -->
    <ProtoSourceDir>$(MSBuildThisFileDirectory)Proto</ProtoSourceDir>

    <!-- Maven artifact versions -->
    <CantonVersion Condition="'$(CantonVersion)' == ''">3.4.11</CantonVersion>
    <GoogleCommonProtosVersion>2.58.0</GoogleCommonProtosVersion>

    <!-- Pinned SHA-256 checksums for each downloaded JAR. Verified before unzip to
         protect against supply-chain tampering (audit F-33). Hashes were obtained by
         downloading each JAR from Maven Central and computing SHA-256; each download
         was also cross-checked against the SHA-1 checksum published by Maven Central.
         When bumping CantonVersion or GoogleCommonProtosVersion, refresh all three in
         the same commit: curl -sL <jar-url> | shasum -a 256, cross-checked against
         <jar-url>.sha1 from Maven Central. -->
    <LedgerApiProtoHash>18edce18db92556a2f2945f470afbba27e0ccdeebd43f13995c42c63f59e3262</LedgerApiProtoHash>
    <LedgerApiValueProtoHash>869d7df5dd2e32f997c2674fea26dc9612dd4b6034d8a583e0275f72303b4668</LedgerApiValueProtoHash>
    <GoogleCommonProtosHash>f8640af546c0afe26477fc5e946a7f455a1afebfc73d021b0c8a5034b8e67152</GoogleCommonProtosHash>

    <!-- Maven Central URLs -->
    <MavenCentralBase>https://repo1.maven.org/maven2</MavenCentralBase>
    <LedgerApiProtoUrl>$(MavenCentralBase)/com/daml/ledger-api-proto/$(CantonVersion)/ledger-api-proto-$(CantonVersion).jar</LedgerApiProtoUrl>
    <LedgerApiValueProtoUrl>$(MavenCentralBase)/com/daml/ledger-api-value-proto/$(CantonVersion)/ledger-api-value-proto-$(CantonVersion).jar</LedgerApiValueProtoUrl>
    <GoogleCommonProtosUrl>$(MavenCentralBase)/com/google/api/grpc/proto-google-common-protos/$(GoogleCommonProtosVersion)/proto-google-common-protos-$(GoogleCommonProtosVersion).jar</GoogleCommonProtosUrl>

    <!-- Cache directory for downloaded JARs -->
    <ProtoCacheDir>$(MSBuildThisFileDirectory)obj/proto-cache</ProtoCacheDir>

    <!-- Marker file to track if protos are already downloaded -->
    <ProtoMarkerFile>$(ProtoSourceDir)/.downloaded-$(CantonVersion)-$(GoogleCommonProtosVersion)</ProtoMarkerFile>
  </PropertyGroup>

  <!-- Download protos during Restore phase so they exist before build -->
  <Target Name="DownloadProtos" BeforeTargets="Restore;CollectPackageReferences;PrepareForBuild" Condition="!Exists('$(ProtoMarkerFile)')">
    <Message Importance="high" Text="Downloading Canton Ledger API protos (version $(CantonVersion))..." />

    <!-- Create directories -->
    <MakeDir Directories="$(ProtoCacheDir)" />
    <MakeDir Directories="$(ProtoSourceDir)" />

    <!-- Download JARs -->
    <DownloadFile
      SourceUrl="$(LedgerApiProtoUrl)"
      DestinationFolder="$(ProtoCacheDir)"
      DestinationFileName="ledger-api-proto-$(CantonVersion).jar"
      SkipUnchangedFiles="true" />

    <DownloadFile
      SourceUrl="$(LedgerApiValueProtoUrl)"
      DestinationFolder="$(ProtoCacheDir)"
      DestinationFileName="ledger-api-value-proto-$(CantonVersion).jar"
      SkipUnchangedFiles="true" />

    <DownloadFile
      SourceUrl="$(GoogleCommonProtosUrl)"
      DestinationFolder="$(ProtoCacheDir)"
      DestinationFileName="proto-google-common-protos-$(GoogleCommonProtosVersion).jar"
      SkipUnchangedFiles="true" />

    <!-- Verify SHA-256 checksums before unzipping (audit F-33, #224) -->
    <GetFileHash Files="$(ProtoCacheDir)/ledger-api-proto-$(CantonVersion).jar" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_LedgerApiProtoActualHash" />
    </GetFileHash>
    <Error Condition="'$(_LedgerApiProtoActualHash)' != '$(LedgerApiProtoHash)'"
           Text="SHA-256 mismatch for ledger-api-proto-$(CantonVersion).jar: expected $(LedgerApiProtoHash), got $(_LedgerApiProtoActualHash)" />

    <GetFileHash Files="$(ProtoCacheDir)/ledger-api-value-proto-$(CantonVersion).jar" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_LedgerApiValueProtoActualHash" />
    </GetFileHash>
    <Error Condition="'$(_LedgerApiValueProtoActualHash)' != '$(LedgerApiValueProtoHash)'"
           Text="SHA-256 mismatch for ledger-api-value-proto-$(CantonVersion).jar: expected $(LedgerApiValueProtoHash), got $(_LedgerApiValueProtoActualHash)" />

    <GetFileHash Files="$(ProtoCacheDir)/proto-google-common-protos-$(GoogleCommonProtosVersion).jar" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_GoogleCommonProtosActualHash" />
    </GetFileHash>
    <Error Condition="'$(_GoogleCommonProtosActualHash)' != '$(GoogleCommonProtosHash)'"
           Text="SHA-256 mismatch for proto-google-common-protos-$(GoogleCommonProtosVersion).jar: expected $(GoogleCommonProtosHash), got $(_GoogleCommonProtosActualHash)" />

    <!-- MSBuild's Unzip task extracts identically on every OS. The previous `unzip` Exec
         relied on Info-ZIP wildcards crossing '/' (com/daml/ledger/api/v2/*.proto also
         matching v2/admin/); the unzip on windows-latest/windows-11-arm runners does not
         cross '/', silently dropping the admin/interactive/testing protos. Full archives
         are extracted (no Include filter): the Protobuf globs in the csproj select what
         is compiled, and $(ProtoSourceDir) is gitignored. -->
    <Unzip SourceFiles="$(ProtoCacheDir)/ledger-api-proto-$(CantonVersion).jar"
           DestinationFolder="$(ProtoSourceDir)"
           OverwriteReadOnlyFiles="true" />

    <Unzip SourceFiles="$(ProtoCacheDir)/ledger-api-value-proto-$(CantonVersion).jar"
           DestinationFolder="$(ProtoSourceDir)"
           OverwriteReadOnlyFiles="true" />

    <Unzip SourceFiles="$(ProtoCacheDir)/proto-google-common-protos-$(GoogleCommonProtosVersion).jar"
           DestinationFolder="$(ProtoSourceDir)"
           OverwriteReadOnlyFiles="true" />

    <!-- Create marker file -->
    <WriteLinesToFile File="$(ProtoMarkerFile)" Lines="Downloaded: $(CantonVersion) + $(GoogleCommonProtosVersion)" Overwrite="true" />

    <Message Importance="high" Text="Proto files downloaded successfully to $(ProtoSourceDir)" />
  </Target>

  <!-- Verify cached JAR checksums on every build, even when DownloadProtos is skipped
       because the marker file exists. Catches tampered cache files and pinned-hash
       changes without requiring a fresh download (audit F-33, #224). -->
  <Target Name="VerifyProtoChecksums" AfterTargets="DownloadProtos"
          Condition="Exists('$(ProtoCacheDir)/ledger-api-proto-$(CantonVersion).jar')">
    <GetFileHash Files="$(ProtoCacheDir)/ledger-api-proto-$(CantonVersion).jar" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_CachedLedgerApiProtoHash" />
    </GetFileHash>
    <Error Condition="'$(_CachedLedgerApiProtoHash)' != '$(LedgerApiProtoHash)'"
           Text="SHA-256 mismatch for cached ledger-api-proto-$(CantonVersion).jar: expected $(LedgerApiProtoHash), got $(_CachedLedgerApiProtoHash)" />

    <GetFileHash Files="$(ProtoCacheDir)/ledger-api-value-proto-$(CantonVersion).jar" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_CachedLedgerApiValueProtoHash" />
    </GetFileHash>
    <Error Condition="'$(_CachedLedgerApiValueProtoHash)' != '$(LedgerApiValueProtoHash)'"
           Text="SHA-256 mismatch for cached ledger-api-value-proto-$(CantonVersion).jar: expected $(LedgerApiValueProtoHash), got $(_CachedLedgerApiValueProtoHash)" />

    <GetFileHash Files="$(ProtoCacheDir)/proto-google-common-protos-$(GoogleCommonProtosVersion).jar" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_CachedGoogleCommonProtosHash" />
    </GetFileHash>
    <Error Condition="'$(_CachedGoogleCommonProtosHash)' != '$(GoogleCommonProtosHash)'"
           Text="SHA-256 mismatch for cached proto-google-common-protos-$(GoogleCommonProtosVersion).jar: expected $(GoogleCommonProtosHash), got $(_CachedGoogleCommonProtosHash)" />
  </Target>

  <!-- Clean target to remove downloaded protos -->
  <Target Name="CleanProtos" AfterTargets="Clean">
    <RemoveDir Directories="$(ProtoSourceDir)" />
    <RemoveDir Directories="$(ProtoCacheDir)" />
  </Target>

</Project>
