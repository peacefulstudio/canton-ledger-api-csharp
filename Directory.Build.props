<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <NoWarn>$(NoWarn);CA1062;CA1852;CA1859</NoWarn>

    <!-- Packaging rigor — identical block in the daml-codegen-csharp twin, keep in sync.
         (This file is promoted to the public twin, so no tracker ids here — see CHANGELOG.)
         Pack-time only, so inert for IsPackable=false projects. SourceLink for GitHub is implicit
         in the .NET SDK; ContinuousIntegrationBuild=true is passed by publish.yaml, never locally. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>

    <!-- Package metadata -->
    <Authors>Peaceful Studio OÜ</Authors>
    <Company>Peaceful Studio OÜ</Company>
    <Copyright>Copyright 2026 Peaceful Studio OÜ</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/peacefulstudio/canton-ledger-api-csharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/peacefulstudio/canton-ledger-api-csharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon.png</PackageIcon>

    <!-- Canton/Daml version - controls which proto version to download -->
    <CantonVersion>3.5.9</CantonVersion>

    <!-- Package versioning. AssemblyVersion/FileVersion derive from $(Version) — the
         release-numeric prefix plus a zero revision — so they can never lag the package
         version again, including when CI overrides Version with a pre-release suffix. -->
    <Version>0.4.1-preview.1</Version>
    <VersionReleasePrefix>$(Version)</VersionReleasePrefix>
    <VersionReleasePrefix Condition="$(VersionReleasePrefix.Contains('-'))">$(VersionReleasePrefix.Substring(0, $(VersionReleasePrefix.IndexOf('-'))))</VersionReleasePrefix>
    <VersionReleasePrefix Condition="$(VersionReleasePrefix.Contains('+'))">$(VersionReleasePrefix.Substring(0, $(VersionReleasePrefix.IndexOf('+'))))</VersionReleasePrefix>
    <AssemblyVersion>$(VersionReleasePrefix).0</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>

    <!-- Package output directory -->
    <PackageOutputPath>$(MSBuildThisFileDirectory)output/nuget</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
