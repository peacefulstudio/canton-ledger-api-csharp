<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Google.Protobuf and Grpc.Tools versions must match daml-codegen-csharp -->
    <PackageVersion Include="Google.Protobuf" Version="3.35.1" />
    <!-- Grpc.Tools >= 2.69.0 ships a linux_arm64 protoc that segfaults (grpc/grpc#38538;
         fix attempt grpc/grpc#41994 shipped in 2.81.x without resolving it); 2.68.1 is the
         last release whose linux_arm64 protoc works. Bump only when #38538 is closed.
         Its protoc (~28.x) is older than the Google.Protobuf 3.35.x runtime; the generated
         code is forward-compatible today, but revisit this skew before bumping
         Google.Protobuf to a version whose generated-code features need a newer protoc. -->
    <PackageVersion Include="Grpc.Tools" Version="2.68.1" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.83.0" />
    <!-- Microsoft Extensions -->
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <!-- Integration with Daml codegen runtime -->
    <PackageVersion Include="Daml.Ledger.Abstractions" Version="0.4.1-preview.1" />
    <PackageVersion Include="Daml.Ledger.Abstractions.Testing.Conformance" Version="0.4.1-preview.1" />
    <PackageVersion Include="Daml.Runtime" Version="0.4.1-preview.1" />
    <!-- Database (PQS) -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- OpenTelemetry (Canton.Ledger.OpenTelemetry only) -->
    <PackageVersion Include="OpenTelemetry" Version="1.18.0" />
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="10.0.3" />
    <!-- Auth -->
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <!-- Resilience (transport-neutral retry seam) -->
    <PackageVersion Include="Polly.Core" Version="8.7.0" />
    <!-- JSON Ledger API client runtime; generator pin lives in .config/dotnet-tools.json -->
    <PackageVersion Include="Refit" Version="15.2.0" />
    <PackageVersion Include="Refit.Reflection" Version="15.2.0" />
    <!-- Testing -->
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.18.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
    <PackageVersion Include="Peaceful.Canton.Localnet.Testing" Version="0.7.3.1" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.0" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.0" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="NSubstitute" Version="6.0.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.10.0" />
  </ItemGroup>
</Project>
