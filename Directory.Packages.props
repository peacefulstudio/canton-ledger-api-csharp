<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Google.Protobuf and Grpc.Tools versions must match daml-codegen-csharp -->
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
    <PackageVersion Include="Grpc.Tools" Version="2.84.0" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.84.0" />
    <!-- Microsoft Extensions -->
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <!-- Integration with Daml codegen runtime -->
    <PackageVersion Include="Daml.Codegen.Testing.Conformance" Version="0.5.0-preview.3" />
    <PackageVersion Include="Daml.Ledger.Abstractions" Version="0.5.0-preview.3" />
    <PackageVersion Include="Daml.Ledger.Abstractions.Testing.Conformance" Version="0.5.0-preview.3" />
    <PackageVersion Include="Daml.Runtime" Version="0.5.0-preview.3" />
    <!-- Database (PQS) -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- OpenTelemetry (Canton.Ledger.OpenTelemetry only) -->
    <PackageVersion Include="OpenTelemetry" Version="1.19.1" />
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="10.0.3" />
    <!-- Auth -->
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <!-- Resilience (transport-neutral retry seam) -->
    <PackageVersion Include="Polly.Core" Version="8.8.0" />
    <!-- JSON Ledger API client runtime; generator pin lives in .config/dotnet-tools.json -->
    <PackageVersion Include="Refit" Version="16.1.0" />
    <!-- Testing -->
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.19.1" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageVersion Include="Peaceful.Canton.Localnet.Testing" Version="0.8.3.2" />
    <PackageVersion Include="Splice.Amulet" Version="0.1.23.12-preview.3" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.1" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.1" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
  </ItemGroup>
</Project>
